# Response headers for the Cloudflare Workers assets deployment.
# Verified under `wrangler dev`: these apply to served assets, and this file is not
# itself served (requesting /_headers returns 404).
#
# This is a fully static site with no backend, no user input, and no query-string
# handling, so these are defense in depth rather than mitigations for a live
# injection path. The one that earns its keep is script-src: it is locked to
# same-origin plus a single hash for the inline no-flash theme script, with no
# 'unsafe-inline', so injected script cannot execute even hypothetically.
#
# style-src keeps 'unsafe-inline' because the SVG artwork carries ~40
# style="stroke:var(--l2)" presentation attributes. Removing that would mean
# rewriting artwork the design spec requires kept verbatim, to close a hole that
# has no way to be reached on a page that renders no external data.
#
# style-src-elem 'self' recovers most of that ground for free: style *attributes*
# fall back through style-src-attr to style-src (so the artwork still paints), while
# an injected inline <style> element is blocked. Engines without the directive ignore
# it and behave exactly as before.
#
# The script hash below must match the inline <script> in index.html byte for byte.
# test/csp.test.js recomputes it from the HTML and fails if they drift.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0NP5ykYNoOaj2DhjvQctX0k/yltI6arlX1LJpDSNADU='; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
