{
	"name": "robertsmj",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/jsdom": "^28.0.3",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"globals": "^15.15.0",
		"jsdom": "^25.0.1",
		"lefthook": "^1.13.6",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7",
		"wrangler": "^4"
	},
	"allowScripts": {
		"lefthook@1.13.6": true,
		"sharp@0.34.5": true,
		"workerd@1.20260721.1": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true
	}
}
